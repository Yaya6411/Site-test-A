rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Avis des lecteurs : lecture publique ; création par un compte connecté
    // (un seul avis par compte et par livre) ; suppression par son auteur uniquement.
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null
        && reviewId == request.auth.uid + '__' + request.resource.data.bookKey
        && request.resource.data.keys().hasOnly(['uid', 'bookKey', 'title', 'rating', 'name', 'comment', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.bookKey is string && request.resource.data.bookKey.size() > 0 && request.resource.data.bookKey.size() <= 200
        && request.resource.data.title is string && request.resource.data.title.size() <= 300
        && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.name is string && request.resource.data.name.size() <= 50
        && request.resource.data.comment is string && request.resource.data.comment.size() <= 2000
        && request.resource.data.createdAt is timestamp;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      // L'auteur peut modifier sa note, son commentaire et son pseudo affiché.
      allow update: if request.auth != null && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'rating', 'comment', 'updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 50
        && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.comment is string && request.resource.data.comment.size() <= 2000
        && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt is timestamp);
    }

    // Profils publics : pseudo et date d'inscription (jamais l'e-mail).
    // Lecture publique ; chaque compte ne peut écrire que son propre profil.
    match /users/{userId} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['name', 'nameLower', 'createdAt', 'photoURL', 'showLibrary'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 30
        && request.resource.data.nameLower == request.resource.data.name.lower()
        && request.resource.data.createdAt is timestamp
        && request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 500;
      allow delete: if request.auth != null && request.auth.uid == userId;

      // Bibliothèque personnelle : visible par son propriétaire, et par tous
      // seulement s'il a choisi « Afficher ma bibliothèque » (showLibrary).
      match /library/{entryId} {
        allow read: if (request.auth != null && request.auth.uid == userId)
          || get(/databases/$(database)/documents/users/$(userId)).data.get('showLibrary', false) == true;
        allow create, update: if request.auth != null && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['title', 'authors', 'cover', 'isbn', 'year', 'pages', 'status', 'favorite', 'addedAt', 'updatedAt', 'readAt'])
          && request.resource.data.title is string && request.resource.data.title.size() <= 300
          && request.resource.data.authors is list && request.resource.data.authors.size() <= 10
          && request.resource.data.cover is string && request.resource.data.cover.size() <= 1000
          && request.resource.data.status in ['', 'to-read', 'reading', 'read']
          && request.resource.data.favorite is bool;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      // Listes personnelles : privées, sauf celles marquées publiques (partageables).
      match /lists/{listId} {
        allow read: if (request.auth != null && request.auth.uid == userId) || resource.data.public == true;
        allow create, update: if request.auth != null && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['name', 'public', 'items', 'createdAt', 'updatedAt'])
          && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 60
          && request.resource.data.public is bool
          && request.resource.data.items is list && request.resource.data.items.size() <= 200;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
